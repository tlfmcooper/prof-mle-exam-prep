{
  "name": "professional-ml-engineer-exam-prep",
  "version": "1.0.0",
  "type": "module",
  "description": "Professional Machine Learning Engineer Exam Preparation Application",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "merge-questions": "tsx scripts/merge-questions.ts",
    "validate-questions": "tsx scripts/validate-questions.ts",
    "ingest-questions": "tsx scripts/ingest-to-supabase.ts",
    "ingest-topics": "tsx scripts/ingest-topics.ts",
    "ingest-all": "tsx scripts/ingest-all.ts",
    "ingest-all:dry-run": "tsx scripts/ingest-all.ts --dry-run",
    "test-ingestion": "tsx scripts/test-ingestion.ts",
    "migrate": "tsx scripts/run-migration.ts",
    "check-plans": "tsx scripts/check-study-plans.ts",
    "compare-questions": "tsx scripts/compare-questions.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "hash-sum": "^2.0.0",
    "jsdom": "^27.0.1",
    "ora": "^9.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.5.4",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.3.0"
  }
}
